# Appwrite Cloud Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id_here
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_appwrite_database_id_here

# Server-only Appwrite API Key (for administrative provisioning, NEVER expose client-side)
APPWRITE_API_KEY=your_server_api_key_here

# LiveKit Real-Time Audio/Video Communication
# Server-only credentials (Never expose client-side or prefix with NEXT_PUBLIC_)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# LiveKit WebSocket Server URL (e.g., wss://your-project.livekit.cloud)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Server-side password for BERK legacy fallback
BERK_PASSWORD=placeholder_secret_password_here
BERK_SESSION_SECRET=placeholder_session_secret_change_me
